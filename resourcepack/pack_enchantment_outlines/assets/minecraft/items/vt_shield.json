{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "fixed",
          "ground",
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "item/shield_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "minecraft:enchantments",
      "ignore_default": true,
      "on_true": {
        "property": "minecraft:display_context",
        "type": "minecraft:select",
        "cases": [
          {
            "when": "thirdperson_lefthand",
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_true": {
                "type": "minecraft:composite",
                "models": [
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/shield/tp_vt_shield_blocking"
                  },
                  {
                    "type": "minecraft:special",
                    "model": {
                      "type": "minecraft:shield"
                    },
                    "base": "minecraft:item/shield_blocking"
                  }
                ]
              },
              "on_false": {
                "type": "minecraft:composite",
                "models": [
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/shield/vt_shield"
                  },
                  {
                    "type": "minecraft:special",
                    "model": {
                      "type": "minecraft:shield"
                    },
                    "base": "minecraft:item/shield"
                  }
                ]
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_true": {
            "type": "minecraft:composite",
            "models": [
              {
                "type": "minecraft:model",
                "model": "minecraft:item/shield/vt_shield_blocking"
              },
              {
                "type": "minecraft:special",
                "model": {
                  "type": "minecraft:shield"
                },
                "base": "minecraft:item/shield_blocking"
              }
            ]
          },
          "on_false": {
            "type": "minecraft:composite",
            "models": [
              {
                "type": "minecraft:model",
                "model": "minecraft:item/shield/vt_shield"
              },
              {
                "type": "minecraft:special",
                "model": {
                  "type": "minecraft:shield"
                },
                "base": "minecraft:item/shield"
              }
            ]
          }
        }
      },
      "on_false": {
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield_blocking",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "property": "minecraft:using_item"
      }
    }
  }
}