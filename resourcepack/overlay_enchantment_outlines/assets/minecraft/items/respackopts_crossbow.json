{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": [
                  "gui",
                  "ground",
                  "fixed"
                ],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_arrow"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "item/respackopts/enchanted_crossbow_arrow"
            }
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": [
                  "gui",
                  "ground",
                  "fixed"
                ],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "item/respackopts/enchanted_crossbow_rocket"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "ground",
              "fixed"
            ],
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_true": {
                "type": "minecraft:range_dispatch",
                "property": "minecraft:crossbow/pull",
                "entries": [
                  {
                    "threshold": 0.58,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_1"
                    }
                  },
                  {
                    "threshold": 1,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_2"
                    }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_0"
                }
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "entries": [
              {
                "threshold": 0.58,
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_2"
                }
              },
              {
                "threshold": 1,
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_3"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "item/enchanted_crossbow_2"
            }
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "item/enchanted_crossbow"
          }
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": [
                  "gui",
                  "ground",
                  "fixed"
                ],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_arrow"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_arrow"
            }
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": [
                  "gui",
                  "ground",
                  "fixed"
                ],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_firework"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "ground",
              "fixed"
            ],
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_true": {
                "type": "minecraft:range_dispatch",
                "property": "minecraft:crossbow/pull",
                "entries": [
                  {
                    "threshold": 0.58,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_1"
                    }
                  },
                  {
                    "threshold": 1,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_2"
                    }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_0"
                }
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "entries": [
              {
                "threshold": 0.58,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_1"
                }
              },
              {
                "threshold": 1,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_2"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_pulling_0"
            }
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow"
          }
        }
      }
    }
  }
}