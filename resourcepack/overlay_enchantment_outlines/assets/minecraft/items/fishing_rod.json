{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "firstperson_lefthand",
            "firstperson_righthand"
          ],
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_true": {
              "type": "minecraft:model",
              "model": "item/firstperson/rod/enchanted_cast_fishing_rod"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "item/firstperson/rod/enchanted_fishing_rod"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": "gui",
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:fishing_rod/cast",
              "on_true": {
                "type": "minecraft:model",
                "model": "minecraft:item/fishing_rod_cast"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/fishing_rod"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:fishing_rod/cast",
          "on_true": {
            "type": "minecraft:model",
            "model": "item/thirdperson/rod/enchanted_cast_fishing_rod"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "item/thirdperson/rod/enchanted_fishing_rod"
          }
        }
      }
    },
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:fishing_rod/cast",
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod_cast"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod"
      }
    }
  }
}